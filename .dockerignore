# Android client (not part of server image)
android/

# Version control
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Environment (secrets — passed at runtime via --env-file)
.env

