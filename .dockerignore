tests/
test_*.py
htmlcov/
coverage.xml
.coverage

# Docs & reports
docs/
*.pdf
*.md
!README.md

# Temp files
*.log
*.txt
!requirements.txt

# Known faces (mounted at runtime, not baked)
known_faces/

# Build artifacts
*.egg-info/
dist/
build/

# Gemini agent artifacts
.gemini/
