# AIVA Environment Variables
# Copy this file to .env and add your actual values

# Gemini API Key (optional — NOT used in navigation loop)
# Get your key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# AIVA Server Settings
AIVA_HOST=0.0.0.0
AIVA_PORT=8765
AIVA_AUTH_TOKEN=aiva-dev-token-2026
AIVA_MAX_CLIENTS=2
AIVA_MAX_FPS=30

# Authentication (Task 2)
# Mode: "static" (dev default) or "jwt" (prod)
AIVA_AUTH_MODE=static
# JWT Secret (generate with: python server/jwt_auth.py --generate-secret)
AIVA_JWT_SECRET=
AIVA_JWT_EXPIRY_HOURS=24
AIVA_JWT_REFRESH_HOURS=48

# Detection Settings
AIVA_YOLO_CONFIDENCE=0.6
AIVA_YOLO_IMG_SIZE=640

# Depth Estimation
AIVA_MIDAS_SKIP=3
AIVA_MIDAS_MOTION_THRESHOLD=1.4

# Obstacle Thresholds (meters)
AIVA_CAUTION_DISTANCE=1.5
AIVA_DANGER_DISTANCE=1.2

# OCR
AIVA_OCR_CONFIDENCE=0.65

# Logging
AIVA_LOG_LEVEL=INFO
